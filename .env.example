# Copy this file to .env and fill in what you use.

# Where price data comes from:
#   yfinance   - free, no key. Uses gold futures (GC=F) as a stand-in for XAUUSD (a few $ different from spot).
#   twelvedata - real XAU/USD spot. Free key at https://twelvedata.com (800 requests/day).
#   mt5        - your MetaTrader 5 terminal (Windows only, terminal must be open and logged in).
#   synthetic  - fake random prices for offline testing.
DATA_PROVIDER=yfinance
TWELVEDATA_API_KEY=
MT5_SYMBOL=XAUUSD

# ---- AI (optional) ----
# Without any AI key, a simple keyword model reads the news and the strategies work alone.
# Which AI to use: auto (Claude if ANTHROPIC_API_KEY is set, otherwise DeepSeek), claude, or deepseek
AI_PROVIDER=auto

# Claude (Anthropic) - https://console.anthropic.com
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# How hard Claude thinks per decision: low, medium, high (higher = slower and more expensive)
AI_EFFORT=medium

# DeepSeek - https://platform.deepseek.com
# Models: deepseek-flash (fast, cheap) or deepseek-v4-pro (stronger, more expensive)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# AI signal mode (needs an AI key):
#   review - the AI checks every signal from the strategies: confirms, adjusts levels, or rejects (default)
#   full   - same, and the AI may also propose its own trades on new candles (more API calls)
#   off    - strategies only
AI_SIGNAL_MODE=review

# Risk settings used for the lot-size calculator
ACCOUNT_BALANCE=1000
RISK_PERCENT=1.0
# Typical XAUUSD spread in dollars (0.30 = 30 cents)
SPREAD=0.30

# MT5 only: your broker's server time offset from UTC in hours (many brokers use 2 or 3)
MT5_UTC_OFFSET=0
