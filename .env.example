# Copy this file to .env and fill in what you use.

# Where price data comes from:
#   yfinance   - free, no key. Uses gold futures (GC=F) as a stand-in for XAUUSD (a few $ different from spot).
#   twelvedata - real XAU/USD spot. Free key at https://twelvedata.com (800 requests/day).
#   mt5        - your MetaTrader 5 terminal (Windows only, terminal must be open and logged in).
#   synthetic  - fake random prices for offline testing.
DATA_PROVIDER=yfinance
TWELVEDATA_API_KEY=
MT5_SYMBOL=XAUUSD

# AI news analysis (optional). Without a key, a simple keyword model is used instead.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Risk settings used for the lot-size calculator
ACCOUNT_BALANCE=1000
RISK_PERCENT=1.0
# Typical XAUUSD spread in dollars (0.30 = 30 cents)
SPREAD=0.30

# MT5 only: your broker's server time offset from UTC in hours (many brokers use 2 or 3)
MT5_UTC_OFFSET=0
